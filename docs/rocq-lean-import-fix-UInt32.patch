+      cbv [UInt32_size Nat_of_num_uint Nat_of_N N.of_num_uint N.of_hex_uint Pos.of_hex_uint Pos.of_hex_uint_acc] in *.
+      cbn [nat_of_Nat] in *.
+      rewrite ?nat2Natid in *.
+      change (N.to_nat 0xd800%N) with 55296%nat in h.
+      change (N.to_nat 0x100000000%N) with 4294967296%nat.
+      lia.
+    - destruct h as [_ h].
