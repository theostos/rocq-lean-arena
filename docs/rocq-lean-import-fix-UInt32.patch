+      cbn [nat_of_Nat] in *.
+      rewrite ?nat2Natid in *.
+      change (N.to_nat 0x110000%N) with 1114112%nat in h.
+      change (N.to_nat 0x100000000%N) with 4294967296%nat.
+      lia.
+  Qed.
